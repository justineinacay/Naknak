{
  "expo": {
    "name": "NakNak",
    "slug": "naknak",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "scheme": "naknak",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.naknak.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "ph.naknak.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
